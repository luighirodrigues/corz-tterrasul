# ============================================================
# Configurações do Banco de Dados PostgreSQL
# ============================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/corz_qualidade?schema=public"

# ============================================================
# API FLW Chat (Bases e Token Permanente)
# ============================================================
FLW_TOKEN="seu_token_permanente_aqui"
FLW_CHAT_URL="https://api.wts.chat/chat"
FLW_CORE_URL="https://api.wts.chat/core"
FLW_CRM_URL="https://api.wts.chat/crm"

# Limite de requisições por minuto para a FLW (segurança)
FLW_RATE_LIMIT_PER_MINUTE=60
# Margem (minutos) somada ao cursor do sync incremental por UpdatedAt
SYNC_OVERLAP_MINUTES=15

# ============================================================
# OpenAI (Análises Estágio 1 e 2)
# ============================================================
OPENAI_API_KEY="sk-..."
OPENAI_MODEL_STAGE1="gpt-4.1-mini"
OPENAI_MODEL_STAGE2="gpt-4.1"
OPENAI_MAX_USD_PER_RUN=50.0
OPENAI_TIMEOUT_STAGE1_MS=60000
OPENAI_TIMEOUT_STAGE2_MS=120000
# Preços em US$ por 1M de tokens (confira na tabela da OpenAI). Vazio/0 = sem teto de custo.
OPENAI_PRICE_STAGE1_INPUT_PER_1M=0
OPENAI_PRICE_STAGE1_OUTPUT_PER_1M=0
STAGE1_MAX_TRANSCRIPT_TOKENS=8000
STAGE1_MAX_ATTEMPTS=5

# ============================================================
# Configuração do Tenant Padrão (Tterrasul)
# ============================================================
DEFAULT_TENANT_ID="tterrasul"
DEFAULT_TENANT_NAME="Tterrasul"
TIMEZONE="America/Sao_Paulo"
# Dia em que a janela semanal começa (ISO: 1=seg ... 7=dom). Janela: seg 00:00 -> dom 23:59
# Trocar com semanas já publicadas exige refazê-las (docs/DEPLOY_EASYPANEL.md, "Semana de segunda a domingo").
PERIOD_WEEK_START=1
# Data de go-live (limita backfill e reanálise). Ex.: 2026-09-01
GO_LIVE_AT=""

# IDs dos quatro painéis CRM da FLW (obtidos via GET /v2/panel)
# Se vazios, o sistema tenta resolver automaticamente pelos títulos:
# "Vendas", "Campanhas", "Peças", "Oficina"
PANEL_VENDAS_ID=""
PANEL_CAMPANHAS_ID=""
PANEL_PECAS_ID=""
PANEL_OFICINA_ID=""
# Títulos EXATOS (usados só se o ID acima estiver vazio). Sem correspondência exata, o Job B falha.
PANEL_VENDAS_TITLE="Vendas"
PANEL_CAMPANHAS_TITLE="Campanhas"
PANEL_PECAS_TITLE="Peças"
PANEL_OFICINA_TITLE="Oficina"

# Motivos de perda (nomes EXATOS do painel, separados por PONTO E VÍRGULA ";" porque há motivos
# com vírgula no nome, ex.: "Já é cliente, transferido para outro setor"). Comparação sem acento/caixa.
# Padrão vazio: nada é desconsiderado. Liste os motivos reais com o comando config:lost-reasons.
# Exemplo: IGNORED_LOST_REASONS="Fornecedor;Veículo indisponivel"
IGNORED_LOST_REASONS=""
# Exemplo: HYGIENE_LOST_REASONS="Duplicado;Já é cliente, transferido para outro setor"
HYGIENE_LOST_REASONS=""

# Relatório por equipe. Na FLW a maioria das equipes é a fila de uma pessoa, então elas são juntadas
# em grupos; cada grupo vira uma "equipe" no relatório. Formato: "Grupo: equipe; equipe | Outro: equipe".
# O nome da equipe da FLW é comparado inteiro (sem acento e caixa), nunca por trecho.
# IGNORED_TEAMS: filas de entrada/robô, que só entram no relatório geral. Vazio em TEAM_GROUPS = desligado.
# No EasyPanel, cole o valor SEM aspas.
TEAM_GROUPS="Vendas: Vendas; Sérgio Vendas; Vinicios Vendas; Dione Vendas; Cristiano Vendas; Vendas - Amanda; Escritório de Vendas; Inicio - campanha vendas | Peças: Peças; Jorge Peças; Leonardo Peças | Pós-venda: Pós Vendas; Henrique Consultor; Keity Consultora | Agendamento: Agendamento | Caixa: Caixa"
IGNORED_TEAMS="Geral; Inicio"

# Cobertura mínima (0-1) para um critério de qualidade entrar na nota da leva
CRITERION_MIN_COVERAGE=0.3

# ============================================================
# Resumo por e-mail (só sai com a flag --email: daily, publish:weekly, publish:monthly e pipeline)
# ============================================================
# Sem SMTP_HOST o envio fica desligado: a publicação segue normal e avisa no terminal.
# SMTP_PORT: 587 (STARTTLS) ou 465 (com SMTP_SECURE=true). A porta 25 costuma ser bloqueada.
# EMAIL_FROM: o remetente precisa ser do domínio do servidor de e-mail, com SPF e DKIM configurados.
# APP_URL: endereço público do painel, com https://, sem barra no fim. É o que o botão "Abrir o resumo" abre.
# Em desenvolvimento, use o Mailpit do docker-compose (docker compose up -d mailpit):
#   SMTP_HOST="localhost"  SMTP_PORT=1025  SMTP_SECURE=false  (sem SMTP_USER e SMTP_PASS)
#   e leia os e-mails em http://localhost:8025
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Tterrasul Qualidade <qualidade@tterrasul.com.br>"
APP_URL="http://localhost:3000"

# ============================================================
# Disparo por HTTP (outro serviço chama /api/jobs/daily, /api/jobs/weekly e /api/jobs/monthly)
# ============================================================
# Vazio = desligado. Mínimo de 32 caracteres; vai no cabeçalho "Authorization: Bearer <token>". Para gerar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOBS_TOKEN=""
