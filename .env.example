# ============================================================
# Configurações do Banco de Dados PostgreSQL
# ============================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/corz_qualidade?schema=public"

# ============================================================
# API FLW Chat (Bases e Token Permanente)
# ============================================================
FLW_TOKEN="seu_token_permanente_aqui"
FLW_CHAT_URL="https://api.wts.chat/chat"
FLW_CORE_URL="https://api.wts.chat/core"
FLW_CRM_URL="https://api.wts.chat/crm"

# Limite de requisições por minuto para a FLW (segurança)
FLW_RATE_LIMIT_PER_MINUTE=60

# ============================================================
# OpenAI (Análises Estágio 1 e 2)
# ============================================================
OPENAI_API_KEY="sk-..."
OPENAI_MODEL_STAGE1="gpt-4.1-mini"
OPENAI_MODEL_STAGE2="gpt-4.1"
OPENAI_MAX_USD_PER_RUN=50.0

# ============================================================
# Configuração do Tenant Padrão (Tterrasul)
# ============================================================
DEFAULT_TENANT_ID="tterrasul"
DEFAULT_TENANT_NAME="Tterrasul"
TIMEZONE="America/Sao_Paulo"
# Dia em que a janela semanal começa (ISO: 1=seg ... 3=qua). Janela: qua 00:00 -> ter 23:59
PERIOD_WEEK_START=3
# Data de go-live (limita backfill e reanálise). Ex.: 2026-09-01
GO_LIVE_AT=""

# IDs dos quatro painéis CRM da FLW (obtidos via GET /v2/panel)
# Se vazios, o sistema tenta resolver automaticamente pelos títulos:
# "Vendas", "Campanhas", "Peças", "Oficina"
PANEL_VENDAS_ID=""
PANEL_CAMPANHAS_ID=""
PANEL_PECAS_ID=""
PANEL_OFICINA_ID=""
# Títulos EXATOS (usados só se o ID acima estiver vazio). Sem correspondência exata, o Job B falha.
PANEL_VENDAS_TITLE="Vendas"
PANEL_CAMPANHAS_TITLE="Campanhas"
PANEL_PECAS_TITLE="Peças"
PANEL_OFICINA_TITLE="Oficina"

# Motivos de perda fora de controle (separados por vírgula)
IGNORED_LOST_REASONS="falta de peca fornecedor,cancelamento de fabrica"

# ============================================================
# Proteção da tela e da API (Basic Auth). Obrigatório em produção.
# ============================================================
REPORT_BASIC_AUTH_USER=""
REPORT_BASIC_AUTH_PASS=""
